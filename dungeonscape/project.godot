; Engine configuration file.
; DungeonScape M0 — tick-based OSRS-skinned dungeon crawler.

config_version=5

[application]

config/name="DungeonScape"
config/description="Single-player fantasy dungeon crawler: tick-based movement, OSRS-like skills & combat, deep multi-biome floors."
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TickClock="*res://autoload/tick_clock.gd"
Game="*res://autoload/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

